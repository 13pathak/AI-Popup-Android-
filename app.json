{
    "expo": {
        "name": "AI Popup",
        "slug": "ai-popup",
        "scheme": "aipopup",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "dark",
        "splash": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#333333"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#333333"
            },
            "package": "com.aipopup.infopedia"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "expo-font",
            [
                "expo-share-intent",
                {
                    "android": {
                        "intentFilters": [
                            {
                                "action": "SEND",
                                "data": {
                                    "mimeType": "text/plain"
                                }
                            },
                            {
                                "action": "android.intent.action.PROCESS_TEXT",
                                "data": {
                                    "mimeType": "text/plain"
                                }
                            }
                        ]
                    },
                    "ios": {
                        "activationRules": {
                            "NSExtensionActivationSupportsText": true
                        }
                    }
                }
            ]
        ],
        "extra": {
            "eas": {
                "projectId": "d5323525-194e-42e3-8eb3-d0236a27866d"
            }
        }
    }
}